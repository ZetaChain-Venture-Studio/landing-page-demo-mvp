# Privy Configuration
# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id-here

# Portal API
NEXT_PUBLIC_PORTAL_API_URL=https://ai-portal-dev.zetachain.com

# PostHog Analytics (for A/B testing)
# Get your keys from https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SnagSolutions Configuration
# Get your API Key and Website ID from https://admin.snagsolutions.io
SNAG_API_KEY=your-snag-api-key-here
SNAG_API_URL=https://admin.snagsolutions.io/api
NEXT_PUBLIC_SNAG_WEBSITE_ID=your-snag-website-id-here
SNAG_ORG_ID=your-snag-org-id-here
SNAG_CURRENCY_ID=your-snag-currency-id-here

# NFT Contract Configuration (after deployment)
# Deploy using: cd nft-contract/pop-ai-nft && npm install && npm run deploy:testnet
POP_AI_NFT_ADDRESS=0x...contract-address-after-deploy
MINTER_PRIVATE_KEY=0x...private-key-of-minter-wallet
ZETACHAIN_TESTNET=true  # Set to false for mainnet
